{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crossmix Puzzle Arcade",
  "version": "0.4.2",
  "identifier": "com.hatdagger.crossmix",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Crossmix Puzzle Arcade", "width": 960, "height": 700, "resizable": true, "center": true, "backgroundColor": "#07060b" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
